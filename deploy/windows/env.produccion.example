# ─────────────────────────────────────────────
# .env de PRODUCCIÓN para el servidor del local (Windows).
# Copiar a apps\backend\.env y completar. NUNCA subir este archivo al repo.
# IMPORTANTE: las rutas de Windows van entre comillas SIMPLES ('C:\...'). Con comillas
# dobles, "\r" y "\n" dentro de la ruta se convierten en saltos de línea y la ruta se rompe.
# Ver docs/instalacion-local.md.
# ─────────────────────────────────────────────

NODE_ENV=production
PORT=3001
TZ="America/Argentina/Buenos_Aires"

# Base de datos: usuario propio de RestOS (no root). Ver paso 3 de la instalación.
DATABASE_URL="mysql://restos:CAMBIAR-CONTRASEÑA-MYSQL@localhost:3306/restos"

# Secreto de las sesiones: generalo con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="CAMBIAR-POR-UN-SECRETO-LARGO-Y-ALEATORIO"
JWT_EXPIRES_IN="12h"
BCRYPT_ROUNDS=10

# Las pantallas las sirve el mismo servidor: no hace falta CORS para la red del local.
# Si en el futuro se entra por un túnel (tarea 6.4), agregar su dirección acá.
CORS_ORIGIN="http://localhost:3001"
# TRUST_PROXY="loopback"   # solo con túnel/proxy adelante (6.4)

# Logs diarios en apps\backend\logs (se borran solos a los 30 días)
LOG_DIR="logs"
LOG_RETENTION_DAYS=30

# ─────────────────────────────────────────────
# Respaldo nocturno (ver docs/restauracion.md)
# ─────────────────────────────────────────────
# Contraseña de cifrado de los respaldos. SIN ELLA NO SE PUEDE RESTAURAR NADA.
# Anotala en papel (sobre cerrado, guardado por el dueño) y en un gestor de contraseñas.
# Generala con: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
BACKUP_PASSPHRASE="CAMBIAR"
BACKUP_DIR='C:\RestOS\respaldos'
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30
BACKUP_UPLOADS_DIR="uploads"
BACKUP_LABEL="RestOS (nombre del local)"

# Copia fuera de la PC (al menos una de las dos):
# a) Una carpeta que se sincroniza a la nube (OneDrive / Google Drive) o un disco externo
# BACKUP_COPY_DIR='C:\Users\Dueño\OneDrive\Respaldos RestOS'
# b) Hostinger por SFTP, con llave SSH (sin contraseña)
# BACKUP_SFTP_HOST="srv123.hstgr.io"
# BACKUP_SFTP_PORT=65002
# BACKUP_SFTP_USER="u123456789"
# BACKUP_SFTP_KEY='C:\RestOS\secretos\hostinger'
# BACKUP_SFTP_DIR="respaldos-restos"

# Aviso si fallan dos noches seguidas:
# WhatsApp con CallMeBot (gratis): https://api.callmebot.com/whatsapp.php?phone=549XXXXXXXXXX&text={mensaje}&apikey=XXXXXX
# o notificación al celular con ntfy.sh: https://ntfy.sh/un-nombre-dificil-de-adivinar
# BACKUP_ALERT_URL='https://...'

# Si MySQL no está en la carpeta estándar:
# MYSQL_BIN_DIR='C:\Program Files\MySQL\MySQL Server 8.0\bin'
