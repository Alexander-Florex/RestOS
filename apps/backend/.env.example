# ─────────────────────────────────────────────
# Base de datos MySQL
# ─────────────────────────────────────────────
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/BASE
# Si usás XAMPP localmente, el user es root sin password y el puerto 3306
DATABASE_URL="mysql://root:@localhost:3306/restos_db"

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# Generá uno largo y aleatorio (ej: openssl rand -base64 48)
JWT_SECRET="cambiame-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"
# Vida del token. La app lo renueva sola mientras está abierta.
JWT_EXPIRES_IN="12h"
BCRYPT_ROUNDS=10

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# Coma-separado si necesitás varios orígenes (ej: prod + staging)
CORS_ORIGIN="http://localhost:5173"

# Solo si hay un proxy o túnel adelante (Cloudflare Tunnel, nginx): "loopback" o la
# cantidad de saltos. Sin esto el límite de intentos de login ve a todos con la IP del proxy.
# TRUST_PROXY="loopback"

# ─────────────────────────────────────────────
# Zona horaria del proceso (logs y fechas del sistema).
# Los días de reportes y tickets se calculan siempre en
# America/Argentina/Buenos_Aires (src/lib/time.ts), aunque esto falte.
# ─────────────────────────────────────────────
TZ="America/Argentina/Buenos_Aires"

# ─────────────────────────────────────────────
# Logs
# En producción se escriben en archivos diarios dentro de LOG_DIR:
#   app-AAAA-MM-DD.log (eventos y errores, JSON) y access-AAAA-MM-DD.log (pedidos HTTP).
# Se borran solos los de más de LOG_RETENTION_DAYS días.
# LOG_TO_FILE=true también los escribe en desarrollo.
# ─────────────────────────────────────────────
# LOG_DIR="logs"
# LOG_RETENTION_DAYS=30
# LOG_TO_FILE=false
