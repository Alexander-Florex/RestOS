// ──────────────────────────────────────────────
// Schema Prisma — RestOS Cliente (multi-tenant)
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// RESTAURANTS — Tenants del sistema
// ──────────────────────────────────────────────
model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  // La base tiene DEFAULT CURRENT_TIMESTAMP (migraciones multitenant y menu_categories): se declara para que esquema y base coincidan (tarea 0.8)
  updatedAt DateTime @default(now()) @updatedAt

  users          User[]
  roles          Role[]
  sections       Section[]
  tables         Table[]
  menuItems      MenuItem[]
  menuCategories MenuCategory[]
  orders         Order[]
  sales          Sale[]
  inventoryItems InventoryItem[]
  recipes        Recipe[]
  staffMembers   StaffMember[]
  reservations   Reservation[]
  takeawayOrders TakeawayOrder[]
  menuOptionGroups MenuItemOptionGroup[]
  auditLogs        AuditLog[]
  itemChanges      OrderItemChange[]
  priceHistory     PriceHistory[]

  @@map("restaurants")
}

// ──────────────────────────────────────────────
// AUTH
// ──────────────────────────────────────────────
model User {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  username     String
  email        String
  password     String
  name         String
  /// Legado: se mantiene sincronizado con roleId (ADMIN / WAITER sin panel / STAFF). Los permisos salen de roleId.
  role         UserRole   @default(STAFF)
  roleId       Int?
  roleRef      Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ordersCreated    Order[]         @relation("OrderCreatedBy")
  ordersCancelled  Order[]         @relation("OrderCancelledBy")
  auditLogs        AuditLog[]
  itemChangesRequested OrderItemChange[] @relation("ChangeRequestedBy")
  itemChangesResolved  OrderItemChange[] @relation("ChangeResolvedBy")
  salesCreated     Sale[]          @relation("SaleRegisteredBy")
  takeawaysCreated TakeawayOrder[] @relation("TakeawayCreatedBy")

  @@unique([restaurantId, username])
  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([roleId])
  @@map("users")
}

/// Rol configurable por restaurante. Los roles de sistema (key != null) no se borran;
/// el de ADMIN tiene siempre todos los permisos.
model Role {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  key          String?
  permissions  Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  users User[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("roles")
}

enum UserRole {
  ADMIN
  WAITER
  STAFF
}

// ──────────────────────────────────────────────
// SECCIONES
// ──────────────────────────────────────────────
model Section {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#64748b")
  order        Int        @default(0)
  tables       Table[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("sections")
}

// ──────────────────────────────────────────────
// MESAS
// ──────────────────────────────────────────────
model Table {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  status       TableStatus @default(AVAILABLE)
  capacity     Int         @default(4)
  enabled      Boolean     @default(true)
  guestCount   Int?
  openedAt     DateTime?
  sectionId    Int?
  section      Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  orders       Order[]
  sales        Sale[]
  reservations Reservation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([sectionId])
  @@map("tables")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
  RESERVED
}

// ──────────────────────────────────────────────
// MENÚ
// ──────────────────────────────────────────────
model MenuItem {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  price        Decimal     @db.Decimal(10, 2)
  description  String?     @db.Text
  stock        StockStatus @default(IN_STOCK)
  enabled      Boolean     @default(true)
  imageUrl     String?
  orderItems   OrderItem[]
  saleItems    SaleItem[]
  takeawayItems TakeawayItem[]
  recipes      Recipe[]
  optionGroups MenuItemOptionGroup[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([restaurantId])
  @@map("menu_items")
}

// ── Personalización de platos (tarea 5.7) ──
// Opciones que carga el Administrador por plato. Al tomar el pedido se guarda
// una copia de lo elegido en OrderItem/TakeawayItem/SaleItem.modifiers, así
// editar la carta después no cambia pedidos ni ventas ya hechos.

/// REMOVE: ingredientes que se pueden sacar ("SIN croutones")
/// SINGLE: elegir uno ("Término: a punto"); si es obligatorio, no se puede pedir sin elegir
/// MULTI:  agregados opcionales, con recargo ("+ Extra queso")
enum MenuOptionGroupType {
  REMOVE
  SINGLE
  MULTI
}

model MenuItemOptionGroup {
  id           Int                 @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String
  type         MenuOptionGroupType
  required     Boolean             @default(false)
  sortOrder    Int                 @default(0)
  options      MenuItemOption[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([restaurantId])
  @@index([menuItemId])
  @@map("menu_item_option_groups")
}

model MenuItemOption {
  id         Int                 @id @default(autoincrement())
  groupId    Int
  group      MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  /// Recargo por unidad (solo agregados y elecciones; en "sacar" es 0)
  priceDelta Decimal             @default(0) @db.Decimal(10, 2)
  /// Viene elegida de entrada (ej. el término más pedido)
  isDefault  Boolean             @default(false)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([groupId])
  @@map("menu_item_options")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// ──────────────────────────────────────────────
// CATEGORÍAS DEL MENÚ
// (entidad propia con orden y color; MenuItem.category sigue siendo texto libre)
// ──────────────────────────────────────────────
model MenuCategory {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#10b981")
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  // La base tiene DEFAULT CURRENT_TIMESTAMP (migraciones multitenant y menu_categories): se declara para que esquema y base coincidan (tarea 0.8)
  updatedAt    DateTime   @default(now()) @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("menu_categories")
}

// ──────────────────────────────────────────────
// PEDIDOS
// ──────────────────────────────────────────────
model Order {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      Int
  table        Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  notes        String?
  createdById  Int?
  createdBy    User?     @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  // Historial (tarea 1.3): los pedidos no se borran al cobrar ni al anular.
  // Solo los OPEN cuentan para la cuenta de la mesa.
  status        OrderStatus @default(OPEN)
  saleId        Int?
  sale          Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  /// Cuándo se cobró o se anuló
  closedAt      DateTime?
  cancelReason  String?     @db.Text
  cancelledById Int?
  cancelledBy   User?       @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  /// Id que genera el dispositivo (tarea 1.5): si el pedido se reintenta tras
  /// un corte, el servidor devuelve el ya creado en vez de duplicarlo
  clientRequestId String?   @db.VarChar(64)
  itemChanges   OrderItemChange[]

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([tableId, status])
  @@index([saleId])
  @@map("orders")
}

/// OPEN: en la cuenta de la mesa · PAID: cobrado (saleId) · CANCELLED: anulado con motivo
enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String
  quantity   Int
  price      Decimal   @db.Decimal(10, 2) // precio unitario final: plato + recargos
  notes      String?
  /// Copia de lo elegido al pedir (ver lib/modifiers.ts)
  modifiers  Json?
  /// ACTIVE: se cobra · VOIDED: anulado por un cambio de plato (no se cobra) — tarea 5.8
  status     OrderItemStatus @default(ACTIVE)
  voidedAt   DateTime?
  voidReason String?         @db.Text
  changes    OrderItemChange[]

  @@index([orderId])
  @@map("order_items")
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

// ── Cambios de platos (tarea 5.8) ──
// REMAKE: rehacer (se cobra una sola vez). REPLACE: cambiar por otro plato
// (el original no se cobra). Si el plato ya estaba hecho, es una pérdida (merma).
// El mozo puede pedir un cambio (PENDING); lo aprueba Caja o Administrador.
enum ItemChangeType {
  REMAKE
  REPLACE
}

enum ItemChangeStatus {
  PENDING
  APPLIED
  REJECTED
}

/// De quién fue el error (lo resuelven en el salón)
enum ItemChangeFault {
  KITCHEN
  WAITER
  CUSTOMER
  OTHER
}

model OrderItemChange {
  id                    Int              @id @default(autoincrement())
  restaurantId          Int
  restaurant            Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId               Int
  order                 Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId           Int
  orderItem             OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  type                  ItemChangeType
  status                ItemChangeStatus @default(PENDING)
  /// Unidades afectadas (ej. 1 de "2x César")
  quantity              Int
  reason                String           @db.Text
  fault                 ItemChangeFault?
  /// Ya estaba hecho: lo que se tira es pérdida
  wasPrepared           Boolean          @default(false)
  /// Copia del ítem original al pedir el cambio (nombre, precio, opciones)
  itemSnapshot          Json
  replacementMenuItemId Int?
  replacementOptionIds  Json?
  replacementNotes      String?          @db.Text
  /// Ítems resultantes al aplicar (el nuevo y la parte anulada)
  newOrderItemId        Int?
  voidedOrderItemId     Int?
  requestedById         Int?
  requestedBy           User?            @relation("ChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  resolvedById          Int?
  resolvedBy            User?            @relation("ChangeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rejectReason          String?          @db.Text
  createdAt             DateTime         @default(now())
  resolvedAt            DateTime?

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@map("order_item_changes")
}

// ──────────────────────────────────────────────
// VENTAS
// ──────────────────────────────────────────────
model Sale {
  id             Int           @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Salón (mesa) o para llevar. Las ventas previas a esta columna son de salón.
  channel        SaleChannel   @default(DINE_IN)
  tableId        Int?
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// Número de mesa al cobrar. Vacío en ventas para llevar.
  tableNumber    Int?
  /// Pedido para llevar que originó la venta. Único: un pedido no genera dos ventas.
  takeawayOrderId Int?          @unique
  takeawayOrder  TakeawayOrder? @relation(fields: [takeawayOrderId], references: [id], onDelete: SetNull)
  paymentMethod  PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?       @db.Text
  imageUrl       String?
  registeredById Int?
  registeredBy   User?         @relation("SaleRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  items          SaleItem[]
  /// Pedidos de mesa que se cobraron en esta venta (tarea 1.3)
  orders         Order[]
  closedAt       DateTime
  createdAt      DateTime      @default(now())

  @@index([restaurantId])
  @@index([closedAt])
  @@index([channel])
  @@map("sales")
}

model SaleItem {
  id         Int       @id @default(autoincrement())
  saleId     Int
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String
  category   String
  quantity   Int
  price      Decimal   @db.Decimal(10, 2)
  subtotal   Decimal   @db.Decimal(10, 2)
  /// Copia de lo elegido al pedir (ver lib/modifiers.ts)
  modifiers  Json?

  @@index([saleId])
  @@index([menuItemId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum SaleChannel {
  DINE_IN
  TAKEAWAY
}

// ──────────────────────────────────────────────
// INVENTARIO
// ──────────────────────────────────────────────
model InventoryItem {
  id           Int               @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  category     InventoryCategory @default(FOOD)
  quantity     Float
  unit         String
  minStock     Float             @default(0)
  costPerUnit  Decimal           @default(0) @db.Decimal(10, 4)
  /// Equivalencia entre familias (tarea 2.1): "1 <unit> = equivalenceQty <equivalenceUnit>",
  /// ej. huevo: 1 un = 60 g. Permite usar el insumo en recetas con otra familia de unidad.
  equivalenceQty  Float?
  equivalenceUnit String?
  /// Presentación de compra (tarea 2.2), ej. bolsa de 25 kg a $25.000. Si está,
  /// costPerUnit se calcula: purchasePrice / (purchaseQty pasado a `unit`)
  purchaseQty   Float?
  purchaseUnit  String?
  purchasePrice Decimal?          @db.Decimal(12, 2)
  /// Merma por defecto al usarlo en recetas (tarea 2.4), 0–0,95. Ej. 0,2 = 20 % se pierde al limpiar
  wastePct      Float             @default(0)
  priceHistory  PriceHistory[]
  supplier     String?
  lastRestocked DateTime?
  recipeIngredients RecipeIngredient[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([restaurantId])
  @@map("inventory_items")
}

enum InventoryCategory {
  FOOD
  BEVERAGE
  SUPPLIES
  EQUIPMENT
}

// ──────────────────────────────────────────────
// RECETAS Y COSTOS
// Costo de elaboración calculado desde InventoryItem; sugiere precio de venta
// según %_ganancia + iva, comparable contra el precio real del MenuItem.
// ──────────────────────────────────────────────
model Recipe {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int?
  menuItem     MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name         String
  yield        Int        @default(1) // porciones que rinde
  profitPct    Float      @default(0.5) // % de ganancia
  vatPct       Float      @default(0.21)
  notes        String?    @db.Text
  /// Rendimiento en unidades (tarea 2.3), ej. 500 cc de chimichurri. Se usa cuando
  /// la receta es componente de otra: costo por unidad de rendimiento = costo total / yieldQty
  yieldQty     Float?
  yieldUnit    String?
  ingredients  RecipeIngredient[] @relation("RecipeLines")
  /// Recetas que usan esta como sub-receta
  usedIn       RecipeIngredient[] @relation("SubRecipeUses")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([menuItemId])
  @@map("recipes")
}

/// Línea de receta: un insumo O una sub-receta (exactamente uno; CHECK en la base).
model RecipeIngredient {
  id              Int            @id @default(autoincrement())
  recipeId        Int
  recipe          Recipe         @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  /// Sub-receta (tarea 2.3); se costea por unidad de rendimiento o por porción
  subRecipeId     Int?
  subRecipe       Recipe?        @relation("SubRecipeUses", fields: [subRecipeId], references: [id], onDelete: Restrict)
  /// Cantidad neta (la que va al plato)
  quantity        Float
  unit            String
  /// Merma de esta línea (tarea 2.4), 0–0,95. null = la del insumo
  wastePct        Float?

  @@index([recipeId])
  @@index([inventoryItemId])
  @@index([subRecipeId])
  @@map("recipe_ingredients")
}

// ──────────────────────────────────────────────
// STAFF
// ──────────────────────────────────────────────
model StaffMember {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  role         StaffRole  @default(WAITER)
  phone        String?
  active       Boolean    @default(true)
  cuit         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("staff_members")
}

enum StaffRole {
  WAITER
  CHEF
  MANAGER
  CASHIER
}

// ──────────────────────────────────────────────
// RESERVAS
// ──────────────────────────────────────────────
model Reservation {
  id           Int               @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      Int?
  table        Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  partySize    Int
  reservedAt   DateTime
  duration     Int               @default(90)
  status       ReservationStatus @default(CONFIRMED)
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([restaurantId])
  @@index([reservedAt])
  @@index([status])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ──────────────────────────────────────────────
// PEDIDOS PARA LLEVAR
// ──────────────────────────────────────────────
model TakeawayOrder {
  id            Int            @id @default(autoincrement())
  restaurantId  Int
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  status        TakeawayStatus @default(OPEN)
  notes         String?        @db.Text
  paymentMethod PaymentMethod?
  amountPaid    Decimal?       @db.Decimal(10, 2)
  total         Decimal?       @db.Decimal(10, 2)
  createdById   Int?
  createdBy     User?          @relation("TakeawayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  paidAt        DateTime?
  items         TakeawayItem[]
  sale          Sale?
  /// Id que genera el dispositivo (ver Order.clientRequestId)
  clientRequestId String?      @db.VarChar(64)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@map("takeaway_orders")
}

model TakeawayItem {
  id         Int           @id @default(autoincrement())
  orderId    Int
  order      TakeawayOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String
  quantity   Int
  price      Decimal       @db.Decimal(10, 2) // precio unitario final: plato + recargos
  notes      String?
  /// Copia de lo elegido al pedir (ver lib/modifiers.ts)
  modifiers  Json?

  @@index([orderId])
  @@map("takeaway_items")
}

enum TakeawayStatus {
  OPEN
  READY
  PAID
  CANCELLED
}

// ── Auditoría (tarea 1.2) ──
// Quién hizo qué, sobre qué, antes/después y por qué. Se escribe en la misma
// transacción que la operación (ver src/lib/audit.ts). Solo se agrega: no hay
// endpoints para editar ni borrar registros.
model AuditLog {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Nombre del usuario en ese momento (queda aunque después se borre la cuenta)
  userName     String?
  /// Ej.: sale.create, order.cancel, menu.price (lista en src/lib/audit.ts)
  action       String
  entity       String
  entityId     Int?
  before       Json?
  after        Json?
  reason       String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
  @@index([restaurantId, entity, entityId])
  @@map("audit_logs")
}

// ── Historial de precios de insumos (tarea 2.5) ──
// Un registro por cada cambio de costPerUnit, con su origen.
enum PriceSource {
  MANUAL
  PURCHASE
  IMPORT
}

model PriceHistory {
  id              Int           @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  costPerUnit     Decimal       @db.Decimal(10, 4)
  previousCost    Decimal?      @db.Decimal(10, 4)
  unit            String
  purchaseQty     Float?
  purchaseUnit    String?
  purchasePrice   Decimal?      @db.Decimal(12, 2)
  source          PriceSource   @default(MANUAL)
  userId          Int?
  userName        String?
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("price_history")
}
